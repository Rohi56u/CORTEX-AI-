# Google Gemini 1.5 Pro API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Firebase Web App Config (Optional for local development)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=neurocommerce-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=neurocommerce-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=neurocommerce-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
